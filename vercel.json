{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'no install step: the build uses only Node built-ins'",
  "buildCommand": "node scripts/build.mjs",
  "outputDirectory": "dist",
  "routes": [
    { "src": "/fonts/(.*)", "headers": { "Cache-Control": "public, max-age=31536000, immutable" }, "continue": true },
    { "src": "/(.*)", "headers": { "X-Content-Type-Options": "nosniff", "Referrer-Policy": "strict-origin-when-cross-origin" }, "continue": true },
    { "src": "/(.+)/", "status": 308, "headers": { "Location": "/$1" } },
    { "src": "/index(\\.html)?", "status": 308, "headers": { "Location": "/" } },
    { "src": "/(.+)/index\\.html", "status": 308, "headers": { "Location": "/$1" } },
    { "handle": "filesystem" },
    { "src": "/(.*)", "status": 404, "dest": "/404.html" }
  ]
}
